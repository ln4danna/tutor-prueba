# Copiar a .env y completar. Nunca subir .env al repo.
DATABASE_URL=sqlite:///./tutor.db
# Obligatoria. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CAMBIAR_POR_VALOR_ALEATORIO
SESSION_MAX_AGE_SECONDS=28800
# true solo si se sirve por HTTPS
COOKIE_SECURE=false
# Clave de Google AI Studio (tier gratuito). Solo en .env, nunca en el código.
AI_API_KEY= clave-api-de-google-ai-studio
# Nombre del modelo Gemini Flash. Verifica el nombre vigente en https://ai.google.dev/gemini-api/docs/models
AI_MODEL= gemini-3.5-flash-lite
# Tiempo máximo de espera para la respuesta del modelo (en segundos)
AI_TIMEOUT_SECONDS=30
