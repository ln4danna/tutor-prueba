# Copiar a .env y completar. Nunca subir .env al repo.
DATABASE_URL=sqlite:///./tutor.db
# Obligatoria. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CAMBIAR_POR_VALOR_ALEATORIO
SESSION_MAX_AGE_SECONDS=28800
# true solo si se sirve por HTTPS
COOKIE_SECURE=false
AI_PROVIDER=gemini
AI_API_KEY=tu-api-key-aqui
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=20
